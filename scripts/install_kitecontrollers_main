#!/bin/bash -eu
rm -rf /tmp/testdepot
mkdir /tmp/testdepot
rm -rf /tmp/test
mkdir /tmp/test
cd /tmp/test
export JULIA_DEPOT_PATH=/tmp/testdepot 
# work around a Pkg bug in Julia 1.13: auto-precompilation after Pkg.add fails with
# "Unknown package" if an indirect dependency changes its version
export JULIA_PKG_PRECOMPILE_AUTO=0
julia --project="." -e 'using Pkg; pkg"add KiteControllers#main"; using KiteControllers; KiteControllers.install_examples(); Pkg.precompile()'
julia --project -e 'using KiteControllers; __PRECOMPILE__ = true; include("examples/autopilot.jl")'
